# Copy to .env and fill in. Never commit real .env files.
# The API validates these at startup and refuses to start if any are missing or invalid.

NODE_ENV=development
PORT=4000

# PostgreSQL connection used by the running API (may be a pooled / pgbouncer URL).
DATABASE_URL=postgresql://voiceledger:voiceledger@localhost:5432/voiceledger

# Optional: direct (non-pooled) connection used for migrations. Falls back to DATABASE_URL.
# DATABASE_URL_UNPOOLED=

# Optional: run inside a specific Postgres schema instead of the default search_path.
# Requires a direct connection (pgbouncer drops startup options).
# DATABASE_SCHEMA=

# Comma-separated list of origins allowed to call the API from a browser (the landing site).
CORS_ORIGINS=http://localhost:3000

# Number of reverse proxies in front of the API (0 = none). Needed for correct client IPs
# in rate limiting when deployed behind a proxy / load balancer.
TRUST_PROXY=0

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Global rate limit: THROTTLE_LIMIT requests per THROTTLE_TTL_SECONDS per client IP.
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120

# Signing secrets: at least 32 characters each and different from one another. Generate with
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Development falls back to built-in defaults when these are empty; production refuses to
# start without its own values.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Lifetime of access tokens (default 15 minutes) and refresh tokens (default 30 days).
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# GET /api/v1/app-config: oldest app version allowed to sync, newest released version, and
# feature flags as a comma-separated list such as sync=true,cloudBackup=false
MIN_APP_VERSION=0.1.0
LATEST_APP_VERSION=0.1.0
FEATURE_FLAGS=

# Encrypted cloud backups: the folder the encrypted files are stored in (mount a disk volume
# here in production), the largest backup accepted in bytes, and how many are kept per shop.
BACKUP_STORAGE_DIR=./data/backups
BACKUP_MAX_BYTES=26214400
BACKUPS_TO_KEEP=10

# e2e tests only: a direct Postgres connection. Each test file creates and drops its own schema.
TEST_DATABASE_URL=postgresql://voiceledger:voiceledger@localhost:5432/voiceledger_test
