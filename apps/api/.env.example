# Copy to .env and fill in. Never commit real .env files.
# The API validates these at startup and refuses to start if any are missing or invalid.

NODE_ENV=development
PORT=4000

# PostgreSQL connection used by the running API (may be a pooled / pgbouncer URL).
DATABASE_URL=postgresql://voiceledger:voiceledger@localhost:5432/voiceledger

# Optional: direct (non-pooled) connection used for migrations. Falls back to DATABASE_URL.
# DATABASE_URL_UNPOOLED=

# Optional: run inside a specific Postgres schema instead of the default search_path.
# Requires a direct connection (pgbouncer drops startup options).
# DATABASE_SCHEMA=

# Comma-separated list of origins allowed to call the API from a browser (the landing site).
CORS_ORIGINS=http://localhost:3000

# Number of reverse proxies in front of the API (0 = none). Needed for correct client IPs
# in rate limiting when deployed behind a proxy / load balancer.
TRUST_PROXY=0

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Global rate limit: THROTTLE_LIMIT requests per THROTTLE_TTL_SECONDS per client IP.
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120

# e2e tests only: a direct Postgres connection. Each test file creates and drops its own schema.
TEST_DATABASE_URL=postgresql://voiceledger:voiceledger@localhost:5432/voiceledger_test
