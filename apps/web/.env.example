# Copy to .env.local and fill in. Never commit real .env files.
# NEXT_PUBLIC_* values are baked into the static site at build time.

# Base URL of the VoiceLedger API (apps/api), without a trailing slash. The web app signs in and
# syncs through <NEXT_PUBLIC_API_URL>/api/v1. Required for production builds; defaults to
# http://localhost:4000 in development.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Public URL of this site, used for canonical and language-alternate links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: contact address shown in the footer and on the privacy and terms pages.
# NEXT_PUBLIC_CONTACT_EMAIL=
