    "semantic": {
      "light": {
        "bg": {
          "canvas": "{neutral.50}",
          "surface": "{neutral.0}",
          "raised": "{neutral.0}",
          "sunken": "{neutral.100}",
          "accent": "{green.100}",
          "hero": "{green.200}",
          "heroEnd": "{lime.100}",
          "overlay": "rgba(10, 20, 16, 0.55)"
        },
        "text": {
          "primary": "{neutral.950}",
          "secondary": "{neutral.600}",
          "disabled": "{neutral.400}",
          "inverse": "{neutral.0}",
          "onAction": "{green.950}",
          "link": "{green.700}"
        },
        "border": {
          "default": "{neutral.200}",
          "strong": "{neutral.500}",
          "focus": "{green.600}"
        },
        "action": {
          "primary": "{green.400}",
          "primaryEnd": "{lime.400}",
          "primaryPressed": "{green.500}",
          "disabled": "{neutral.200}"
        },
        "status": {
          "success": "{green.700}",
          "warning": "{amber.700}",
          "danger": "{red.600}",
          "info": "{blue.600}",
          "successBg": "{green.100}",
          "warningBg": "{amber.50}",
          "dangerBg": "{red.50}",
          "infoBg": "{blue.50}"
        },
        "money": {
          "paid": "{green.700}",
          "due": "{red.600}",
          "cancelled": "{neutral.600}"
        },
        "confidence": {
          "low": "{amber.700}",
