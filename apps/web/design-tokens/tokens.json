        "700": "#8F1B1B",
        "800": "#6B1414",
        "900": "#3F0F0F"
      },
      "amber": {
        "50": "#FFF6E0",
        "100": "#FDE7B0",
        "200": "#FAD47A",
        "300": "#F5C04A",
        "400": "#E8A21A",
        "500": "#C98206",
        "600": "#A16504",
        "700": "#7A4C03",
        "800": "#593703",
        "900": "#3A2402"
