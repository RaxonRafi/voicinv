          "canvas": "{neutral.950}",
          "surface": "{neutral.900}",
          "raised": "{neutral.900}",
          "sunken": "{neutral.850}",
          "accent": "{green.925}",
          "hero": "{green.800}",
          "heroEnd": "{lime.800}",
          "overlay": "rgba(0, 0, 0, 0.7)"
        },
        "text": {
          "primary": "{green.50}",
          "secondary": "{neutral.400}",
          "disabled": "{neutral.500}",
          "inverse": "{neutral.950}",
          "onAction": "{green.950}",
          "link": "{green.300}"
        },
        "border": {
          "default": "{neutral.800}",
          "strong": "{neutral.400}",
          "focus": "{green.300}"
        },
        "action": {
          "primary": "{green.400}",
          "primaryEnd": "{lime.400}",
          "primaryPressed": "{green.500}",
          "disabled": "{neutral.800}"
        },
        "status": {
          "success": "{green.400}",
          "warning": "{amber.300}",
          "danger": "{red.300}",
          "info": "{blue.300}",
          "successBg": "{green.925}",
          "warningBg": "{amber.900}",
          "dangerBg": "{red.900}",
          "infoBg": "{blue.900}"
        },
        "money": {
          "paid": "{green.400}",
          "due": "{red.300}",
          "cancelled": "{neutral.400}"
        },
        "confidence": {
          "low": "{amber.300}",
          "lowBg": "{amber.900}"
        }
      }
    }
  },
  "typography": {
    "fontFamily": {
      "sans": ["Noto Sans", "Noto Sans Bengali", "system-ui", "sans-serif"],
      "latin": "Noto Sans",
      "bengali": "Noto Sans Bengali"
    },
    "scale": {
      "hero": { "fontSize": 44, "lineHeight": 56, "fontWeight": 700, "tabularNums": true },
      "display": { "fontSize": 32, "lineHeight": 44, "fontWeight": 700 },
      "title": { "fontSize": 24, "lineHeight": 34, "fontWeight": 700 },
      "heading": { "fontSize": 20, "lineHeight": 30, "fontWeight": 600 },
      "body": { "fontSize": 16, "lineHeight": 26, "fontWeight": 400 },
      "bodyStrong": { "fontSize": 16, "lineHeight": 26, "fontWeight": 600 },
      "label": { "fontSize": 14, "lineHeight": 22, "fontWeight": 500 },
      "caption": { "fontSize": 12, "lineHeight": 18, "fontWeight": 400 },
      "captionStrong": { "fontSize": 12, "lineHeight": 18, "fontWeight": 600 },
      "overline": {
        "fontSize": 13,
        "lineHeight": 20,
        "fontWeight": 600,
        "letterSpacing": 1,
        "uppercase": true
      },
      "amount": { "fontSize": 20, "lineHeight": 30, "fontWeight": 600, "tabularNums": true }
    }
  },
  "spacing": {
    "none": 0,
    "xs": 4,
    "sm": 8,
    "md": 12,
    "lg": 16,
    "xl": 24,
    "2xl": 32,
    "3xl": 48,
    "4xl": 64
  },
  "radius": {
    "sm": 6,
    "md": 10,
    "lg": 16,
    "xl": 20,
    "2xl": 24,
    "full": 9999
  },
  "elevation": {
    "none": { "offsetY": 0, "blur": 0, "opacity": 0, "android": 0 },
    "sm": { "offsetY": 2, "blur": 8, "opacity": 0.05, "android": 1 },
    "md": { "offsetY": 8, "blur": 24, "opacity": 0.08, "android": 4 },
    "lg": { "offsetY": 16, "blur": 40, "opacity": 0.16, "android": 12 }
  },
  "motion": {
    "duration": { "fast": 150, "base": 200, "slow": 250 },
    "easing": {
      "standard": [0.2, 0, 0, 1],
      "enter": [0, 0, 0, 1],
      "exit": [0.3, 0, 1, 1]
    }
  },
  "zIndex": {
    "base": 0,
    "raised": 10,
    "sticky": 100,
    "overlay": 1000,
    "modal": 1100,
    "toast": 1200
  },
  "size": {
    "touchTarget": 48,
    "control": 56,
    "tile": 44,
    "mic": 72,
    "icon": { "sm": 16, "md": 20, "lg": 24, "xl": 32 }
  }
}
