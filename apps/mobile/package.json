{
  "name": "voiceledger-mobile",
  "version": "0.1.0",
  "private": true,
  "description": "VoiceLedger mobile app: offline-first, voice-first invoicing and customer credit ledger. Standalone app; deployed on its own.",
  "main": "expo-router/entry",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "tokens": "node design-tokens/generate.mjs",
    "start": "pnpm tokens && expo start --dev-client",
    "android": "pnpm tokens && expo run:android",
    "ios": "pnpm tokens && expo run:ios",
    "lint": "eslint .",
    "typecheck": "pnpm tokens && tsc -p tsconfig.json --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm tokens && jest",
    "test:watch": "pnpm tokens && jest --watch",
    "bundle:check": "pnpm tokens && expo export --clear --platform android --output-dir .expo-export-check"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "trailingComma": "all",
    "semi": true,
    "endOfLine": "lf"
  },
  "op-sqlite": {
    "sqlcipher": true
  },
  "dependencies": {
    "@expo-google-fonts/noto-sans": "^0.4.2",
    "@expo-google-fonts/noto-sans-bengali": "^0.4.4",
    "@hookform/resolvers": "^7.0.5",
    "@op-engineering/op-sqlite": "^19.0.5",
    "@shopify/flash-list": "2.3.2",
    "drizzle-orm": "^0.45.4",
    "expo": "~58.0.24",
    "expo-asset": "~58.0.21",
    "expo-constants": "~58.0.16",
    "expo-contacts": "~58.0.10",
    "expo-crypto": "~58.0.8",
    "expo-dev-client": "~58.0.19",
    "expo-document-picker": "~58.0.5",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.12",
    "expo-image": "~58.0.18",
    "expo-linking": "~58.0.17",
    "expo-local-authentication": "~58.0.3",
    "expo-localization": "~58.0.5",
    "expo-print": "~58.0.9",
    "expo-router": "~58.0.31",
    "expo-secure-store": "~58.0.3",
    "expo-sharing": "~58.0.23",
    "expo-speech": "~58.0.4",
    "expo-speech-recognition": "^58.0.1",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "i18next": "^27.1.1",
    "lucide-react-native": "^1.72.0",
    "react": "19.3.0",
    "react-hook-form": "^7.92.0",
    "react-i18next": "^18.0.1",
    "react-native": "0.88.1",
    "react-native-iap": "^17.3.5",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-view-shot": "6.1.1",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/node": "^22.20.5",
    "@types/react": "~19.3.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.14",
    "prettier": "^3.10.0",
    "test-renderer": "^1.3.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2"
  }
}
