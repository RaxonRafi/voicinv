# Copy to .env and fill in. Never commit real .env files.
# EXPO_PUBLIC_* values are bundled into the app at build time.

# Base URL of the VoiceLedger API, without a trailing slash. Only used for the optional
# account features (sign in, cloud backup, sync, subscription check). The core loop
# (voice → invoice → ledger → share/print) never needs it.
EXPO_PUBLIC_API_URL=http://10.0.2.2:4000
