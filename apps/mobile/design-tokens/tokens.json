  "typography": {
    "fontFamily": {
      "sans": ["Noto Sans", "Noto Sans Bengali", "system-ui", "sans-serif"],
      "latin": "Noto Sans",
      "bengali": "Noto Sans Bengali"
    },
    "scale": {
      "display": { "fontSize": 32, "lineHeight": 44, "fontWeight": 700 },
      "title": { "fontSize": 24, "lineHeight": 34, "fontWeight": 700 },
      "heading": { "fontSize": 20, "lineHeight": 30, "fontWeight": 600 },
      "body": { "fontSize": 16, "lineHeight": 26, "fontWeight": 400 },
      "bodyStrong": { "fontSize": 16, "lineHeight": 26, "fontWeight": 600 },
      "label": { "fontSize": 14, "lineHeight": 22, "fontWeight": 500 },
      "caption": { "fontSize": 12, "lineHeight": 18, "fontWeight": 400 },
      "amount": { "fontSize": 20, "lineHeight": 30, "fontWeight": 600, "tabularNums": true }
    }
  },
  "spacing": {
    "none": 0,
    "xs": 4,
    "sm": 8,
    "md": 12,
    "lg": 16,
    "xl": 24,
    "2xl": 32,
    "3xl": 48,
    "4xl": 64
  },
  "radius": {
    "sm": 6,
    "md": 10,
    "lg": 16,
    "full": 9999
  },
  "elevation": {
    "none": { "offsetY": 0, "blur": 0, "opacity": 0, "android": 0 },
    "sm": { "offsetY": 1, "blur": 2, "opacity": 0.08, "android": 1 },
    "md": { "offsetY": 4, "blur": 12, "opacity": 0.1, "android": 4 },
    "lg": { "offsetY": 12, "blur": 32, "opacity": 0.14, "android": 12 }
  },
  "motion": {
    "duration": { "fast": 150, "base": 200, "slow": 250 },
    "easing": {
      "standard": [0.2, 0, 0, 1],
      "enter": [0, 0, 0, 1],
      "exit": [0.3, 0, 1, 1]
    }
  },
  "zIndex": {
    "base": 0,
    "raised": 10,
    "sticky": 100,
    "overlay": 1000,
    "modal": 1100,
    "toast": 1200
  },
  "size": {
    "touchTarget": 48,
    "icon": { "sm": 16, "md": 20, "lg": 24, "xl": 32 }
  }
}
