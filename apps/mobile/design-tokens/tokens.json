      "blue": {
        "50": "#E9F1FD",
        "100": "#C9DCF9",
        "200": "#A3C3F4",
        "300": "#7FAAEF",
        "400": "#4F88E3",
        "500": "#2B69CC",
        "600": "#1F53A8",
        "700": "#183F80",
        "800": "#122E5E",
        "900": "#0C1F40"
