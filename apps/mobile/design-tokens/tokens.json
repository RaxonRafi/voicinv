    "semantic": {
      "light": {
        "bg": {
          "canvas": "{neutral.50}",
          "surface": "{neutral.0}",
          "raised": "{neutral.0}",
          "sunken": "{neutral.100}",
          "overlay": "rgba(14, 16, 15, 0.6)"
        },
        "text": {
          "primary": "{neutral.900}",
          "secondary": "{neutral.600}",
          "disabled": "{neutral.400}",
          "inverse": "{neutral.0}",
          "onAction": "{neutral.0}",
          "link": "{green.700}"
        },
        "border": {
          "default": "{neutral.300}",
          "strong": "{neutral.500}",
          "focus": "{green.600}"
        },
        "action": {
          "primary": "{green.600}",
          "primaryPressed": "{green.700}",
          "disabled": "{neutral.200}"
        },
        "status": {
          "success": "{green.600}",
          "warning": "{amber.700}",
          "danger": "{red.600}",
          "info": "{blue.600}",
          "successBg": "{green.50}",
          "warningBg": "{amber.50}",
          "dangerBg": "{red.50}",
          "infoBg": "{blue.50}"
        },
        "money": {
          "paid": "{green.600}",
          "due": "{red.600}",
          "cancelled": "{neutral.600}"
        },
        "confidence": {
          "low": "{amber.700}",
          "lowBg": "{amber.100}"
        }
      },
      "dark": {
        "bg": {
          "canvas": "{neutral.950}",
          "surface": "{neutral.900}",
          "raised": "{neutral.800}",
          "sunken": "{neutral.950}",
          "overlay": "rgba(0, 0, 0, 0.7)"
        },
        "text": {
          "primary": "{neutral.50}",
          "secondary": "{neutral.300}",
          "disabled": "{neutral.500}",
          "inverse": "{neutral.900}",
          "onAction": "{neutral.950}",
          "link": "{green.300}"
        },
        "border": {
          "default": "{neutral.700}",
          "strong": "{neutral.400}",
          "focus": "{green.300}"
        },
        "action": {
          "primary": "{green.400}",
          "primaryPressed": "{green.300}",
          "disabled": "{neutral.700}"
        },
        "status": {
          "success": "{green.300}",
          "warning": "{amber.300}",
          "danger": "{red.300}",
          "info": "{blue.300}",
          "successBg": "{green.900}",
          "warningBg": "{amber.900}",
          "dangerBg": "{red.900}",
